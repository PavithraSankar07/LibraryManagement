@page "/bookdetails"
@using LibraryManagement.Models

@inject HttpClient Http

<h3>Book Details</h3>

<button @onclick="ShowAddForm">Add Book</button>

<table class="table">
    <thead>
        <tr>
            <th>Book ID</th>
            <th>Name</th>
            <th>Author</th>
            <th>Availability</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in books)
        {
            <tr>
                <td>@book.BookID</td>
                <td>@book.BookName</td>
                <td>@book.AuthorName</td>
                <td>@book.Availability</td>
                <td>
                    <button @onclick="() => EditBook(book)" >Edit</button>
                    <button @onclick="() => DeleteBook(book.BookID)" >Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (isFormVisible)
{
    <EditForm Model="currentBook" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Name:</label>
            <InputText @bind-Value="currentBook.BookName" />
        </div>
        <div>
            <label>Author:</label>
            <InputText @bind-Value="currentBook.AuthorName" />
        </div>
        <div>
            <label>Availability:</label>
            <select @bind="currentBook.Availability">
    @foreach (var avail in Enum.GetValues(typeof(Availability)).Cast<Availability>())
    {
        <option value="@avail.ToString()">@avail</option>
    }
</select>

        </div>
        <button type="submit">@((isEditMode) ? "Update" : "Add")</button>
        <button type="button" @onclick="CancelForm">Cancel</button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}
@code {
    private List<BookDetails> books = new();
    private BookDetails currentBook = new();
    private bool isFormVisible = false;
    private bool isEditMode = false;
    private string message = "".ToString();
    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        books = await Http.GetFromJsonAsync<List<BookDetails>>("api/books");
    }

    private void ShowAddForm()
    {
        currentBook = new BookDetails();
        isFormVisible = true;
        isEditMode = false;
        message = "".ToString();
    }

    private void EditBook(BookDetails book)
    {
        currentBook = new BookDetails
        {
            BookID = book.BookID,
            BookName = book.BookName,
            AuthorName = book.AuthorName,
            Availability = book.Availability
        };
        isFormVisible = true;
        isEditMode = true;
        message = "".ToString();
    }

    private async Task DeleteBook(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete book {id}?");
        if (!confirmed)
            return;

        var response = await Http.DeleteAsync($"api/books/{id}");
        if (response.IsSuccessStatusCode)
        {
            message = "Deleted successfully.";
            await LoadBooks();
        }
        else
        {
            message = "Delete failed.";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isEditMode)
        {
            var response = await Http.PutAsJsonAsync($"api/books/{currentBook.BookID}", currentBook);
            if (response.IsSuccessStatusCode)
            {
                message = "Updated successfully.";
                isFormVisible = false;
                await LoadBooks();
            }
            else
            {
                message = "Update failed.";
            }
        }
        else
        {
            var response = await Http.PostAsJsonAsync("api/books", currentBook);
            if (response.IsSuccessStatusCode)
            {
                message = "Added successfully.";
                isFormVisible = false;
                await LoadBooks();
            }
            else
            {
                message = "Add failed.";
            }
        }
    }

    private void CancelForm()
    {
        isFormVisible = false;
        message = "".ToString();
    }

    [Inject]
    private IJSRuntime JS { get; set; }
}
