    }
    @* --------------------- *@
    private List<BookDetails> books = new();
    private BookDetails currentBook = new();
    private bool isFormVisible = false;
    @* private bool isEditMode = false; *@
    @* private string message = "".ToString(); *@
    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
    }
    private async Task LoadBooks()
    {
        books = await Http.GetFromJsonAsync<List<BookDetails>>("api/books");
            StateHasChanged();
    }
    private void ShowAddForm()
    {
        currentBook = new BookDetails();
        @* isFormVisible = true; *@
        isEditMode = false;
        ShowModal=true;
        @* message = "".ToString(); *@
    }

    private void EditBook(BookDetails book)
    {
        currentBook = new BookDetails
        {
            BookID = book.BookID,
            BookName = book.BookName,
            AuthorName = book.AuthorName,
            Availability = book.Availability
        };
        @* isFormVisible = true; *@
        isEditMode = true;
        ShowModal = true;
        @* message = "".ToString(); *@
    }
private async Task DeleteBook(string id)
{
    var book = books.FirstOrDefault(b => b.BookID == id);
    if (book != null)
    {
        await Http.DeleteAsync($"api/books/{id}");
        await LoadBooks();
ShowModal1("Deleted successfully.");
        @* message = "Deleted successfully.";
        visible=true; *@

    }
}
private async Task HandleBookSubmit(BookDetails book)
{
    HttpResponseMessage response;

    if (isEditMode)
    {
        response = await Http.PutAsJsonAsync($"api/books/{book.BookID}", book);
    }
    else
    {
        response = await Http.PostAsJsonAsync("api/books", book);
    }

    if (response.IsSuccessStatusCode)
    {
        message = isEditMode ? "Book updated." : "Book added.";
        await LoadBooks();
    }
    else
    {
        message = "Operation failed.";
    }

    ShowModal = false;
}


    private void CancelForm()
    {
        isFormVisible = false;
        message = "".ToString();
    }

    
}
