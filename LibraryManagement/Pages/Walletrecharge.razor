@page "/walletrecharge"
@inject HttpClient Http
@using LibraryManagement.Models
@inject UserStateService UserState
<div class="whole">
   
<h3>Wallet Recharge</h3>
<div class="mb-3">
    <label>Amount:</label>
    <input type="number" @bind="amount" />
</div>
<button @onclick="RechargeAmount">Recharge</button>
</div>



<CustomDialog_copy
    Message="@modalMessage" 
    IsVisible="@isModalVisible" 
    ShowConfirmButtons="false" 
    OnClose="CloseModal" />
@code {
    @* private string userID;*@
    private int amount;
    private string modalMessage;
    private bool isModalVisible;


    private async Task RechargeAmount()
    {
        if (string.IsNullOrWhiteSpace(UserState.CurrentUser.UserID))
        {
            ShowModal("Please enter a valid User ID.");
            return;
        }

        if (amount <= 0)
        {
            ShowModal("Please enter a valid recharge amount.");
            return;
        }

        try
        {
            Console.WriteLine(UserState.CurrentUser.UserID);
            var response = await Http.PostAsync($"api/personal/recharge/{UserState.CurrentUser.UserID}/{amount}", null);

            if (response.IsSuccessStatusCode)
            {
                @* StateHasChanged(); *@
                modalMessage = $"Wallet recharged successfully {amount}.Your total amount {UserState.CurrentUser.WalletBalance}";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                modalMessage = "User not found.";
            }
            else
            {
                modalMessage = "Error while recharging wallet.";
            }

            isModalVisible = true;
        }
        catch (Exception ex)
        {
            ShowModal($"Exception: {ex.Message}");
        }
    }

    private void ShowModal(string message)
    {
        modalMessage = message;
        isModalVisible = true;
    }

    private Task CloseModal()
    {
        isModalVisible = false;
        return Task.CompletedTask;
    }
} 

