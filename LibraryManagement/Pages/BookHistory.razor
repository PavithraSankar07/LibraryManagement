@page "/bookhistory"
@using LibraryManagement.Models
@inject HttpClient Http
@inject UserStateService UserState

<h3>Book History</h3>

@if (UserState.CurrentUser == null)
{
    <p>Please log in to view your borrow history.</p>
}
else if (borrowList == null)
{
    <p><em>Loading...</em></p>
}
else if (borrowList.Count == 0)
{
    <p>No borrow history found.</p>
}
else
{
    <table class="book-history-table">
        <thead>
            <tr>
                <th>Book ID</th>
                <th>Borrow ID</th>
                <th>Borrowed Date</th>
                <th>Paid Fine Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in borrowList)
            {
                <tr>
                    <td>@book.BookID</td>
                    <td>@book.SerialNumber</td>
                    <td>@book.BorrowedDate.ToShortDateString()</td>
                    <td>₹@book.PaidFineAmount</td>
                    <td>@book.BookingStatus</td>
                    <td>
                        @if (book.BookingStatus == BookingStatus.Borrowed)
                        {
                            <button @onclick="() => OpenReturnModal(book.BorrowID)">Return</button>

                        }
                        else
                        {
                            <span>Returned</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="message-box">@message</div>
}

<ReturnBookModal IsVisible="@showReturnModal"
                 Message="@modalMessage"
                 OnConfirm="HandleReturnConfirm"
                 OnCancel="CloseReturnModal"
                 OnClose="CloseReturnModal" />

@code {
    private List<BorrowDetails> borrowList;
    private string message;

    private bool showReturnModal = false;
    private string modalMessage = "";
    private string borrowIdToReturn;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (UserState.CurrentUser != null)
        {
            var userId = UserState.CurrentUser.UserID;
            borrowList = await Http.GetFromJsonAsync<List<BorrowDetails>>($"api/history/{userId}");
        }
        else
        {
            message = "You must be logged in.";
        }
    }

    private void OpenReturnModal(string borrowId)
    {
        borrowIdToReturn = borrowId;
        modalMessage = "Do you want to return this book? Please indicate if it is damaged.";
        showReturnModal = true;
    }

    private void CloseReturnModal()
    {
        showReturnModal = false;
        modalMessage = "";
    }
   private async Task HandleReturnConfirm(bool isDamaged)
{
    // Close modal immediately on confirm click
    showReturnModal = false;

    var jsonContent = new StringContent(
        $"{{\"isDamaged\":{isDamaged.ToString().ToLower()}}}",
        System.Text.Encoding.UTF8,
        "application/json");

    var response = await Http.PostAsync($"api/history/return/{borrowIdToReturn}", jsonContent);

    if (response.IsSuccessStatusCode)
    {
        var result = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
        if (result != null && result.TryGetValue("message", out var msg))
        {
            modalMessage = msg;
        }
        else
        {
            modalMessage = await response.Content.ReadAsStringAsync();
        }
    }
    else
    {
        var error = await response.Content.ReadAsStringAsync();
        modalMessage = $"Failed to return book: {error}";
    }

    await LoadData();
}


