@inject UserStateService User
@inject NavigationManager Navigation

@if (User.CurrentUser != null)

{
    <div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <a class="navbar-brand" href="">Medical Store</a>

       <div class="user-dropdown position-relative">
    <div class="dropdown-toggle d-inline-flex align-items-center" @onclick="ToggleDropdown" style="cursor:pointer; user-select:none;" title="@User.CurrentUser.UserName">
        <span>@User.CurrentUser.UserName</span>
        @* <span class="ms-1">&#x25BC;</span>  *@
    </div>
    @if (isDropdownOpen)
    {
        <ul class="dropdown-menu show" style="display: block; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);">
            <li><a class="dropdown-item" href="#" @onclick="Logout">Logout</a></li>
            <li><a class="dropdown-item" href="/profile">Profile</a></li>
        </ul>
    }
</div>


        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

