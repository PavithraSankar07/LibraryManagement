@using LibraryManagement.Models

@if (Show)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-content" @onclick:stopPropagation>
            <EditForm Model="bookModel" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="modal-header">
                    <h4>@(bookModel.BookID == null ? "Add Book" : "Edit Book")</h4>
                    <button class="close-button" @onclick="Close">×</button>
                </div>

                <div class="modal-body">
                    <label>Book Name</label>
                    <InputText @bind-Value="bookModel.BookName" class="form-control" />
                    <ValidationMessage For="@(() => bookModel.BookName)" />

                    <label>Author Name</label>
                    <InputText @bind-Value="bookModel.AuthorName" class="form-control" />
                    <ValidationMessage For="@(() => bookModel.AuthorName)" />

                    <label>Availability</label>
                    <select @bind="bookModel.Availability" class="form-control">
                        @foreach (var avail in Enum.GetValues(typeof(Availability)).Cast<Availability>())
                        {
                            <option value="@avail">@avail</option>
                        }
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn1">Save</button>
                    <button type="button" class="btn2" @onclick="Close">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public BookDetails Book { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback<BookDetails> OnValidSubmit { get; set; }

    private BookDetails bookModel = new();

    protected override void OnParametersSet()
    {
        if (Show && Book != null)
        {
            bookModel = new BookDetails
            {
                BookID = Book.BookID,
                BookName = Book.BookName,
                AuthorName = Book.AuthorName,
                Availability = Book.Availability
            };
        }
    }

    private async Task Submit()
    {
        await OnValidSubmit.InvokeAsync(bookModel);
        await ShowChanged.InvokeAsync(false);
    }

    private async Task Close()
    {
        await ShowChanged.InvokeAsync(false);
    }
}
