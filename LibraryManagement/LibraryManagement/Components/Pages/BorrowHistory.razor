@page "/borrowhistory"
@using LibraryManagement.Components.Models
@using LibraryManagement.Components.Service
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider authenticationState
@inject HttpClient httpClient
@inject BorrowDetailsService borrowDetailsServices
@attribute [Authorize(Roles = "Admin,User")]
<p>BH</p>
@* //         •	BorrowID (Auto Increment – LB2000)
        // •	BookID 
        // •	UserID
        // •	BorrowedDate – (Current Date)
        // •	BookingStatus – (Enum - Default, Borrowed, Returned)
        // •	PaidFineAmount *@
<table class="book-table">
    <thead>
        <tr>
            <th>Serial number</th>
            <th>BookID</th>
            <th>UserID</th>
            <th>BorrowedDate</th>
            <th>Booking Status</th>
            <th>Fine</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var borrow in borrows)
        {
            <tr>
                <td>1</td>
                <td>@borrow.BookID</td>
                <td>@borrow.UserID</td>
                <td>@borrow.BorrowedDate</td>
                <td>@borrow.BookingStatus</td>
                <td>@borrow.PaidFineAmount</td>
                <td>
                      @if (borrow.BookingStatus == BookingStatus.Borrowed)
                    {
                        <button @onclick="() => Cancel(borrow.BorrowID)">Cancel</button>
                    }
                    else
                    {
                    <button disabled=@Isdisable>Return</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code
{
    string message="";
    List<BorrowDetails> borrows = new();
     
    BorrowDetails borrowDetails = new BorrowDetails();
   
    protected override async Task OnInitializedAsync()
    {
        borrows = borrowDetailsServices.GetAllBooks();
         Console.WriteLine(borrows.Count);
    }
bool Isdisable=true;
    private async void Cancel(int borrowid)
    {
        Console.WriteLine("Success111");
        
        var cookieHeader=HttpContextAccessor.HttpContext.Request.Headers["Cookie"].ToString();
        var request = new HttpRequestMessage(HttpMethod.Put,$"api/borrow/cancel/{borrowid}")
        {
            Content=null
        };
        request.Headers.Add("Cookie",cookieHeader);
        var response = await httpClient.SendAsync(request);
        if(response.IsSuccessStatusCode)
        {
            
            int number = await response.Content.ReadFromJsonAsync<int>();
            switch(number)
            {

                case 0:
                {
                    Isdisable=true;
                     Console.WriteLine("Success");
                    break;
                }
                case 1:
                {
                     Console.WriteLine("issue");
                     break;
                }

            }
        }
        else
        {
            Console.WriteLine("fail");
        }
          StateHasChanged();
    }

}