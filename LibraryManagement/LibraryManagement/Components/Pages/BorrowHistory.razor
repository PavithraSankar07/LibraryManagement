@page "/borrowhistory"
@using LibraryManagement.Components.Models
@using LibraryManagement.Components.Service
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer
@inject AuthenticationStateProvider authenticationState
@inject HttpClient httpClient
@inject BorrowDetailsService borrowDetailsServices
@attribute [Authorize(Roles = "Admin,User")]
<p>BH</p>
@* //         •	BorrowID (Auto Increment – LB2000)
        // •	BookID 
        // •	UserID
        // •	BorrowedDate – (Current Date)
        // •	BookingStatus – (Enum - Default, Borrowed, Returned)
        // •	PaidFineAmount *@
<table>
    <thead>
        <tr>
            <th>Serial number</th>
            <th>BookID</th>
            <th>UserID</th>
            <th>BorrowedDate</th>
            <th>Booking Status</th>
            <th>Fine</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var borrow in borrows)
        {
            <tr>
                <td>1</td>
                <td>@borrow.BookID</td>
                <td>@borrow.UserID</td>
                <td>@borrow.BorrowedDate</td>
                <td>@borrow.BookingStatus</td>
                <td>@borrow.PaidFineAmount</td>
                <td>
                      @if (borrow.BookingStatus == BookingStatus.Borrowed)
                    {
                        <button @onclick="() => Cancel(borrow.BorrowID)">Cancel</button>
                    }
                    else
                    {
                        <span>Returned</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code
{
