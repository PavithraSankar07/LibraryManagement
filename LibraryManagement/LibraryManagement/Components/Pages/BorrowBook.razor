@page "/borrowbook"
@using LibraryManagement.Components.Models
@using LibraryManagement.Components.Service
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer

@inject BookDetailsService bookDetailsServices
@inject UserService userServices
@inject BorrowDetailsService borrowDetailsServices
@inject AuthenticationStateProvider authenticationState
@inject HttpClient httpClient
@attribute [Authorize(Roles = "Admin,User")]

<table>
    <thead>
        <tr>
            <th>Book Name</th>
            <th>Author Name</th>
            <th>Availability Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (BookDetails book in books)
        {
            <tr>
                <td>@book.BookName</td>
                <td>@book.AuthorName</td>
                <td>@book.Availability</td>
                <td>
                    <button @onclick="() => BorrowBooks(book.BookID)">Borrow</button>
                </td>
            </tr>
        }
    </tbody>
</table>
